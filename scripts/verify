#!/usr/bin/env bash
# Full local verification, intentionally aligned with the CI test coverage.
set -euo pipefail

verify_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$verify_root"

if command -v asdf >/dev/null 2>&1; then
  # asdf 0.16+ is a binary: unlike the legacy shell implementation it does
  # not alter PATH when invoked, so non-interactive verification must prefer
  # its shims explicitly.
  asdf_data_dir="${ASDF_DATA_DIR:-$HOME/.asdf}"
  if [[ -d "$asdf_data_dir/shims" ]]; then
    export PATH="$asdf_data_dir/shims:$PATH"
  fi
elif [[ -f "$HOME/.asdf/asdf.sh" ]]; then
  # Legacy asdf releases need their shell integration loaded first.
  . "$HOME/.asdf/asdf.sh"
fi

server_pids=()
verify_tmp="$(mktemp -d)"
demo_port=4101
gsd_port=4102

cleanup() {
  for server_pid in "${server_pids[@]}"; do
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  done

  rm -rf "$verify_tmp"
}

trap cleanup EXIT

mix format --check-formatted

(
  cd apps/demo_gsd_tracker
  MIX_ENV=test mix ecto.create
  MIX_ENV=test mix ecto.migrate
)
MIX_ENV=test mix test
node --test apps/phx_maplibre/test/js/*.test.mjs

npm ci --prefix apps/demo_berlin_districts
npm ci --prefix apps/demo_berlin_districts/assets
npm ci --prefix apps/demo_gsd_tracker
npm ci --prefix apps/demo_gsd_tracker/assets

(
  cd apps/demo_gsd_tracker
  MIX_ENV=dev mix ecto.create
  MIX_ENV=dev mix ecto.migrate
)
MIX_ENV=dev mix gsd_tracker.fetch_land_cover

(
  cd apps/demo_berlin_districts
  mix tailwind.install --if-missing
  mix esbuild.install --if-missing
  mix assets.build
)

(
  cd apps/demo_gsd_tracker
  mix tailwind.install --if-missing
  mix esbuild.install --if-missing
  mix assets.build
)

DEMO_PORT="$demo_port" GSD_PORT="$gsd_port" MIX_ENV=dev mix phx.server > "$verify_tmp/phx-server.log" 2>&1 &
server_pids=("$!")

for port in "$demo_port" "$gsd_port"; do
  for attempt in $(seq 1 60); do
    if curl -sSf -o /dev/null "http://127.0.0.1:${port}/"; then
      break
    fi

    if [[ "$attempt" -eq 60 ]]; then
      cat "$verify_tmp/phx-server.log" >&2
      exit 1
    fi

    sleep 2
  done
done

(
  cd apps/demo_berlin_districts
  PLAYWRIGHT_BASE_URL="http://127.0.0.1:${demo_port}" npx playwright test --reporter=line --workers=1
)

(
  cd apps/demo_gsd_tracker
  GSD_PORT="$gsd_port" npx playwright test --reporter=line
)
