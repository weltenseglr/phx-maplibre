{
  "name": "phx-maplibre-dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "JakeBecker.elixir-ls",
        "phoenixframework.phoenix",
        "ms-playwright.playwright"
      ]
    }
  },
  "remoteUser": "vscode",
  "userEnvProbe": "none",
  "containerEnv": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "ASDF_DIR": "/home/vscode/.asdf",
    "ASDF_DATA_DIR": "/home/vscode/.asdf"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.asdf/shims:/home/vscode/.asdf/bin:${containerEnv:PATH}",
    "MIX_HOME": "/home/vscode/.mix",
    "HEX_HOME": "/home/vscode/.hex"
  },
  "postCreateCommand": "bash /workspace/.devcontainer/setup.sh"
}
